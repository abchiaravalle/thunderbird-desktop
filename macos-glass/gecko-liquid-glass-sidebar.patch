 - (void)prefChanged;
 @end
 
+// Hosts a Liquid Glass (NSGlassEffectView, macOS 26+) panel for vibrant
+// sidebar regions when widget.macos.sidebar-glass is enabled. The host is
+// transparent to mouse events, so the whole subtree is skipped by hitTest.
+@interface MOZGlassHostView : NSView
+- (void)prefChanged;
+@end
+
 static NSVisualEffectState VisualEffectStateForVibrancyType(
     VibrancyType aType) {
   switch (aType) {
@@ -78,6 +85,51 @@ - (void)prefChanged {
 }
 @end
 
+@implementation MOZGlassHostView
+- (instancetype)initWithFrame:(NSRect)aRect {
+  self = [super initWithFrame:aRect];
+  if (@available(macOS 26.0, *)) {
+    auto* glass = [[NSGlassEffectView alloc] initWithFrame:self.bounds];
+    glass.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    [self addSubview:glass];
+    [glass release];
+    [self prefChanged];
+  }
+  return self;
+}
+
+- (NSView*)hitTest:(NSPoint)aPoint {
+  // Like MOZVibrantView, this view must be transparent to mouse events.
+  return nil;
+}
+
+- (void)prefChanged {
+  if (@available(macOS 26.0, *)) {
+    for (NSView* sub in self.subviews) {
+      if ([sub isKindOfClass:[NSGlassEffectView class]]) {
+        auto* glass = static_cast<NSGlassEffectView*>(sub);
+        glass.cornerRadius =
+            StaticPrefs::widget_macos_sidebar_glass_corner_radius();
+        glass.style = StaticPrefs::widget_macos_sidebar_glass_clear()
+                          ? NSGlassEffectViewStyleClear
+                          : NSGlassEffectViewStyleRegular;
+      }
+    }
+  }
+}
+@end
+
+static bool UseGlassForVibrancyType(VibrancyType aType) {
+  if (aType != VibrancyType::Sidebar ||
+      !StaticPrefs::widget_macos_sidebar_glass()) {
+    return false;
+  }
+  if (@available(macOS 26.0, *)) {
+    return true;
+  }
+  return false;
+}
+
 static void PrefChanged(const char* aPref, void* aClosure) {
   static_cast<VibrancyManager*>(aClosure)->PrefChanged();
 }
